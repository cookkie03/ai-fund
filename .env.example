# ==============================================================================
# Trading Agent Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Never commit .env to version control!
# ==============================================================================

# --- Broker (Alpaca Paper Trading) ---
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_TRADING_URL=https://paper-api.alpaca.markets/v2

# --- LLM Endpoint (OmniRoute or OpenAI-Compatible) ---
# Key for the LLM router / endpoint
OMNIROUTE_API_KEY=your_omniroute_api_key_here
# Endpoint for agent LLM calls (default: local OmniRoute proxy)
OFFICE_LLM_ENDPOINT=http://127.0.0.1:20128/v1

# --- Market Data ---
# Provider for market prices: "yahoo" (default, free) or "openbb"
DATA_PRICES_PROVIDER=yahoo

# --- Runtime Configuration ---
# Path to central SQLite database
TRADING_AGENT_DB=data/trading-agent.db
# HTTP/SSE API port for the engine
TRADING_AGENT_API_PORT=8765
# Label for the broker account managed by this runtime instance
TRADING_AGENT_ACCOUNT_LABEL=default
# URL used by CLI commands to reach the runtime
TRADING_AGENT_RUNTIME_URL=http://127.0.0.1:8765

# --- Frontend Cockpit ---
# Dev server port for the Vite frontend
COCKPIT_PORT=5174
# Target runtime URL proxied by the frontend
COCKPIT_RUNTIME_URL=http://127.0.0.1:8765
